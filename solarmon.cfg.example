[query]
interval = 1
offline_interval = 60
error_interval = 60

[solarmon]
port = /dev/ttyUSB0

[inverters.main]
unit = 1

[mqtt]
enable = true
host = 127.0.0.1
port = 1883
# username =
# password =
base_topic = solar/inverter
retain = true
# Home Assistant MQTT discovery
ha_discovery = true
ha_prefix = homeassistant
device_id = solar_inverter
device_name = Solar Inverter
